<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Loaded into the instrumented Target application, so it has no dependencies outside the framework -->
    <AssemblyName>DotReplay.Recorder</AssemblyName>
    <RootNamespace>DotReplay.Recorder</RootNamespace>
  </PropertyGroup>

</Project>
