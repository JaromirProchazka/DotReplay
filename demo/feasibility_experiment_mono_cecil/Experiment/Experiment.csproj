<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>cecil-experiment</AssemblyName>
    <RootNamespace>DotReplay.Experiment</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Copies DotReplay.Recorder.dll next to the experiment, from where the weaver deploys it -->
    <ProjectReference Include="..\Recorder\Recorder.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
  </ItemGroup>

</Project>
