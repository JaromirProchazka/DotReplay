<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- The mock stands in for the dotreplay CLI: bin/Debug/net8.0/dotreplay.dll -->
    <AssemblyName>dotreplay</AssemblyName>
    <RootNamespace>DotReplay.Mock</RootNamespace>
  </PropertyGroup>

</Project>
