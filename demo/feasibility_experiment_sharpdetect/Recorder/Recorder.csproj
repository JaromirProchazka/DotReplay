<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Loaded into the instrumented Target application. SharpDetect skips assemblies starting with "DotReplay." -->
    <AssemblyName>DotReplay.ThreadRecorder</AssemblyName>
    <RootNamespace>DotReplay.ThreadRecorder</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The value serializer of the Mono.Cecil experiment, reused unchanged -->
    <Compile Include="..\..\feasibility_experiment_mono_cecil\Recorder\ValueSerializer.cs" Link="ValueSerializer.cs" />
  </ItemGroup>

</Project>
