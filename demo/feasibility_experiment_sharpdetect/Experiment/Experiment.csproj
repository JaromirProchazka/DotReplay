<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>sharpdetect-experiment</AssemblyName>
    <RootNamespace>DotReplay.Experiment</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <CecilExperiment>..\..\feasibility_experiment_mono_cecil\Experiment\</CecilExperiment>
  </PropertyGroup>

  <ItemGroup>
    <!-- Method lookup, captured identifiers and type names of the Mono.Cecil experiment, reused unchanged -->
    <Compile Include="$(CecilExperiment)MethodSpec.cs" Link="Linked\MethodSpec.cs" />
    <Compile Include="$(CecilExperiment)Target.cs" Link="Linked\Target.cs" />
    <Compile Include="$(CecilExperiment)TypeNames.cs" Link="Linked\TypeNames.cs" />
    <Compile Include="$(CecilExperiment)ExperimentError.cs" Link="Linked\ExperimentError.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Copies DotReplay.ThreadRecorder.dll next to the experiment, from where the weaver deploys it -->
    <ProjectReference Include="..\Recorder\Recorder.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AngleSharp" Version="1.8.6" />
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
  </ItemGroup>

</Project>
