<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Mirror the Java demo: calc-app.jar with Main-Class com.example.CalcApp -->
    <AssemblyName>calc-app</AssemblyName>
    <RootNamespace>Com.Example</RootNamespace>
    <StartupObject>Com.Example.CalcApp</StartupObject>
  </PropertyGroup>

</Project>
